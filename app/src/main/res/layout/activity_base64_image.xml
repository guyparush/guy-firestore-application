<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:gravity="center"
    android:padding="16dp">

    <EditText
        android:id="@+id/etFileName"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:hint="שם התמונה"
        android:gravity="center" />

    <ImageView
        android:id="@+id/ivImage"
        android:layout_width="250dp"
        android:layout_height="250dp"
        android:layout_margin="16dp"
        android:scaleType="fitCenter"
        android:contentDescription="תמונה שנבחרה"
        android:background="#EEEEEE" />

    <Button
        android:id="@+id/btnGallery"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="בחר תמונה מהגלריה" />

    <Button
        android:id="@+id/btnCamera"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="צלם תמונה" />

    <Button
        android:id="@+id/btnSaveImage"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="שמור תמונה ב-Firestore" />

    <Button
        android:id="@+id/btnReadImage"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="קרא תמונה מ-Firestore" />

</LinearLayout>